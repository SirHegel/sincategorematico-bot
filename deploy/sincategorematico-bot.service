[Unit]
Description=Bot local Sincategoremático para Telegram
Documentation=file:///home/sirhegel/Documentos/Repos/sincategorematico-bot/README.md
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/sirhegel/Documentos/Repos/sincategorematico-bot
EnvironmentFile=/home/sirhegel/.config/sincategorematico-bot/bot.env
Environment=PYTHONPATH=/home/sirhegel/Documentos/Repos/sincategorematico-bot/src
Environment=SINCATEGOREMATICO_CONFIG_PATH=/home/sirhegel/Documentos/Repos/sincategorematico-bot/config.toml
Environment=SINCATEGOREMATICO_STATE_PATH=/home/sirhegel/.local/state/sincategorematico-bot/state.db
ExecStart=/usr/bin/python3 -m sincategorematico_bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
Nice=10
CPUQuota=20%
MemoryHigh=256M
MemoryMax=512M
TasksMax=32
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sirhegel/.local/state/sincategorematico-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
