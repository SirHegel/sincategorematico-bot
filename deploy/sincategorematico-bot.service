[Unit]
Description=Bot local Sincategoremático para Telegram
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=@HOME@/.config/sincategorematico-bot/bot.env
UnsetEnvironment=SINCATEGOREMATICO_DASHBOARD_TOKEN SINCATEGOREMATICO_LINKEDIN_CLIENT_ID SINCATEGOREMATICO_LINKEDIN_CLIENT_SECRET
Environment=PYTHONPATH=@PROJECT_ROOT@/src
Environment=SINCATEGOREMATICO_CONFIG_PATH=@PROJECT_ROOT@/config.toml
Environment=SINCATEGOREMATICO_STATE_PATH=@HOME@/.local/state/sincategorematico-bot/state.db
ExecStart=/usr/bin/python3 -m sincategorematico_bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
Nice=10
CPUQuota=20%
MemoryHigh=256M
MemoryMax=512M
TasksMax=32
LimitNOFILE=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.local/state/sincategorematico-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
