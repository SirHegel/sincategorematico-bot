[Unit]
Description=Panel web local de Sincategoremático
After=network.target sincategorematico-bot.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=@HOME@/.config/sincategorematico-bot/bot.env
UnsetEnvironment=SINCATEGOREMATICO_TELEGRAM_TOKEN SINCATEGOREMATICO_CLAIM_SHA256 SINCATEGOREMATICO_CLAIM_EXPIRES_AT SINCATEGOREMATICO_LINKEDIN_CLIENT_ID SINCATEGOREMATICO_LINKEDIN_CLIENT_SECRET
Environment=PYTHONPATH=@PROJECT_ROOT@/src
Environment=SINCATEGOREMATICO_CONFIG_PATH=@PROJECT_ROOT@/config.toml
Environment=SINCATEGOREMATICO_STATE_PATH=@HOME@/.local/state/sincategorematico-bot/state.db
ExecStart=/usr/bin/python3 -m sincategorematico_bot.dashboard
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.local/state/sincategorematico-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=256M

[Install]
WantedBy=default.target
